{
  "name": "Meal",
  "type": "object",
  "properties": {
    "date": {
      "type": "string",
      "format": "date"
    },
    "meal_type": {
      "type": "string",
      "enum": [
        "breakfast",
        "lunch",
        "dinner",
        "snack"
      ]
    },
    "food_description": {
      "type": "string",
      "description": "Raw user input or food name"
    },
    "quantity": {
      "type": "number",
      "description": "Number of servings consumed"
    },
    "food_name": {
      "type": "string"
    },
    "serving_size": {
      "type": "string",
      "description": "Human-readable serving label (e.g. '1 cup (240g)')"
    },
    "serving_size_g": {
      "type": "number",
      "description": "Actual grams consumed \u2014 used to reconstruct per100g for recents"
    },
    "calories": {
      "type": "number"
    },
    "protein_g": {
      "type": "number"
    },
    "carbs_g": {
      "type": "number"
    },
    "fat_g": {
      "type": "number"
    },
    "fiber_g": {
      "type": "number"
    },
    "sugar_g": {
      "type": "number"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "date",
    "meal_type",
    "food_description"
  ]
}