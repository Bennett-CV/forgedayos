{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "user"
      ],
      "default": "user"
    },
    "weight_lbs": {
      "type": "number",
      "description": "Current body weight in pounds"
    },
    "height_inches": {
      "type": "number",
      "description": "Height in inches"
    },
    "age": {
      "type": "number",
      "description": "Age in years"
    },
    "gender": {
      "type": "string",
      "enum": [
        "male",
        "female"
      ],
      "description": "Biological sex for BMR calculation"
    },
    "activity_level": {
      "type": "string",
      "enum": [
        "sedentary",
        "light",
        "moderate",
        "active",
        "very_active"
      ],
      "description": "Daily activity level"
    },
    "fitness_goal": {
      "type": "string",
      "enum": [
        "lose_weight",
        "maintain",
        "gain_muscle"
      ],
      "description": "Primary fitness goal"
    },
    "target_weight_lbs": {
      "type": "number",
      "description": "Goal weight in pounds"
    },
    "books": {
      "type": "array",
      "description": "Structured reading list (title, status, optional progress)",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "author": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["want", "reading", "finished"]
          },
          "progress_pct": { "type": "number" },
          "started_date": { "type": "string" },
          "finished_date": { "type": "string" },
          "updated_at": { "type": "string" }
        }
      }
    },
    "nutrition_goals": {
      "type": "object",
      "description": "Daily nutrition targets",
      "properties": {
        "calories": {
          "type": "number"
        },
        "protein_g": {
          "type": "number"
        },
        "carbs_g": {
          "type": "number"
        },
        "fat_g": {
          "type": "number"
        }
      }
    },
    "notification_prefs": {
      "type": "object",
      "description": "Smart nudge preferences (Weekly Review, Today next action, stale weigh-in)",
      "properties": {
        "weekly_review": { "type": "boolean" },
        "today_next": { "type": "boolean" },
        "stale_weigh_in": { "type": "boolean" },
        "stale_days": { "type": "number" }
      }
    },
    "health_import": {
      "type": "object",
      "description": "Last user-initiated Health file import metadata",
      "properties": {
        "last_at": { "type": "string" },
        "source": { "type": "string" },
        "counts": { "type": "object" }
      }
    }
  },
  "required": []
}