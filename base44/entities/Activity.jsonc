{
  "name": "Activity",
  "type": "object",
  "properties": {
    "pillar": {
      "type": "string",
      "enum": [
        "career",
        "health",
        "wealth",
        "learning",
        "relationships"
      ],
      "description": "Which life pillar this activity belongs to"
    },
    "category": {
      "type": "string",
      "description": "Activity category (e.g., lifting, running, reading, coding, outreach)"
    },
    "title": {
      "type": "string",
      "description": "Short description of the activity"
    },
    "value": {
      "type": "number",
      "description": "Numeric value (miles, pages, dollars, reps, etc.)"
    },
    "unit": {
      "type": "string",
      "description": "Unit of measurement"
    },
    "points": {
      "type": "number",
      "description": "Momentum points earned"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Date of the activity"
    },
    "notes": {
      "type": "string",
      "description": "Optional notes"
    }
  },
  "required": [
    "pillar",
    "title",
    "points",
    "date"
  ]
}